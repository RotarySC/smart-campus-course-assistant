# ---- Node / 前端骨架 ----
node_modules/
.pnpm-store/
web/dist/
web/.vite/
*.tsbuildinfo
.env.local
.env.*.local
.npmrc.local

# ---- Python ----
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.venv/
venv/

# ---- 后端运行期产物 ----
# 本地配置、上传原件、抽取文本、日志与测试数据库文件不入库
backend/.env
backend/.env.*
backend/uploads/
backend/var/
backend/logs/

# ---- 多智能体并行开发工作树 ----
# 每车道一个 git worktree，避免并发 checkout 互相踩踏
.worktrees/

# ---- 临时 / 验证产物补充 ----
pip-*_/

# ---- docs/ 不纳入版本控制 ----
# 需求与设计文档目录，按项目决定不随代码库跟踪。
# 文件仍完整保留在磁盘上（脚本照常读取）；仅是不再由 git 管理。
# 如需临时恢复跟踪某一文件：git add -f docs/<path>
docs/

# ---- 根目录文档不纳入版本控制 ----
# 按项目决定，仓库只跟踪代码（design/ 与 web/）；根目录的文档不再入库。
# 例外：README.md 是仓库入口（一段最少量的上手说明 + 指向 docs/STARTUP.md），保持跟踪。
# 注意：本文件 .gitignore 自身必须保持被跟踪，否则新克隆会失去全部忽略规则。
/CONTRIBUTING.md
/.debug_phase_status_prev.md
/.debug_*

# ---- 临时 / 验证产物 ----
# 本地静态服务器与浏览器取证的临时目录
.cdp-probe-profile/
.debug/
debug.log
*.tmp

# ---- 编辑器 / 系统 ----
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# ---- uv 本机缓存（国内镜像安装用） ----
.uv-cache/


# ---- pytest / 临时脚本产物 ----
pytest-of-*/
backend/pytest-of-*/
/backend/tmp*


# ---- verification/ 不纳入版本控制 ----
# 独立验证目录（判定报告、可复现脚本与证据），按项目决定不随代码库跟踪。
# 文件仍完整保留在磁盘上（脚本照常可跑）；仅是不再由 git 管理。
# 如需临时恢复跟踪某一文件：git add -f verification/<path>
verification/

