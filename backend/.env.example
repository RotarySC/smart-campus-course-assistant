# 校园课程智能助手后端 · 环境配置示例（真实 .env 不入库）
# 复制为 backend/.env 后按需修改。所有键均可被进程环境变量覆盖（环境变量优先于 .env）。
# P1-5（2026-10-28）：**全部 CCA_* 键都读本文件**（进程环境变量 > 本文件 > 代码默认值），
# 写进来即生效、无需启动前 export；显式空串也算显式值。可用 CCA_ENV_FILE 指向另一份
# .env；本文件按进程缓存，运行中修改需重启进程才生效。
#
# 覆盖范围：本文件 = 后端代码实际读取的完整键集合（54 个：DATABASE_URL + 53 个 CCA_*），
# 由“代码读取键集合 vs 本文件键集合”脚本自查 0 缺失（自查命令与结果见 QA-02 提交信息）。
# 标注「生产必须覆盖」的键不得沿用本文件的开发默认值。

# ===================== 数据库 =====================
# MySQL 连接串（开发用示例：仓库容器 cca-mysql；测试禁止连开发库 cca）。
# 生产必须覆盖，且口令只放服务端秘密配置，不写入仓库。
DATABASE_URL=mysql+aiomysql://root:cca_dev_root@127.0.0.1:33061/cca_test_core?charset=utf8mb4

# ===================== 运行环境 =====================
# 运行环境：dev / test / prod（prod 下未处理异常日志只记类型，不回传堆栈）。
CCA_ENV=dev

# ===================== 学校与业务 =====================
# 学校业务时区（业务日期按此时区解析；中国无夏令时，缺 tzdata 时回退固定 +08:00）。
CCA_SCHOOL_TIMEZONE=Asia/Shanghai
# 列表分页默认每页条数（1–100）。
CCA_PAGE_DEFAULT_SIZE=20
# 列表分页允许的最大每页条数（1–100）。
CCA_PAGE_MAX_SIZE=100
# 个人课表单次查询最大跨度（自然日，1–31）。
CCA_SCHEDULE_MAX_DAYS=31

# ===================== 会话与草稿 =====================
# 登录会话有效期（秒，默认 7200 = 2 小时；无自动续期）。
CCA_SESSION_TTL_SECONDS=7200
# 助手草稿有效期（秒，默认 1800 = 30 分钟；过期返回 410 DRAFT_EXPIRED）。
CCA_DRAFT_TTL_SECONDS=1800

# ===================== 上传限额（Phase 2） =====================
# 单批最多文件数（1–10）。
CCA_UPLOAD_MAX_FILES=10
# 单文件最大字节数（默认 20 MiB）。
CCA_UPLOAD_MAX_FILE_BYTES=20971520
# 整批最大总字节数（默认 50 MiB）。
CCA_UPLOAD_MAX_TOTAL_BYTES=52428800

# ===================== 前端来源 =====================
# CORS 允许的前端来源（逗号分隔；回环开发默认 5173）。
CCA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===================== 服务认证与委派签名 =====================
# 内部 API / MCP 服务凭据。开发占位；生产必须覆盖为随机强凭据，不得使用本值。
CCA_SERVICE_TOKEN=dev-internal-token
# 委派 JWT 签名密钥。开发占位（非生产）；生产必须覆盖为随机强密钥并纳入轮换（TBD-03）。
CCA_DELEGATION_SIGNING_KEY=dev-delegation-key-not-for-production

# ===================== 知识链路存储 / 解析（Phase 2） =====================
# 原件/抽取文本根目录；留空 = backend/uploads（已 gitignore）。生产建议显式绝对路径。
CCA_FILESTORE_ROOT=
# 本地向量索引根目录；留空 = backend/var/vector（已 gitignore）。生产按部署卷覆盖。
CCA_VECTOR_ROOT=
# 确定性本地 Embedding 维度（8–1024，默认 64）。非生产 AI；真实模型由 TBD-04 冻结后替换。
CCA_EMBEDDING_DIM=64
# 分块大小（码点，默认 500）。改动会改变 parser_config_digest，需重建向量后再发布。
CCA_CHUNK_SIZE=500
# 分块重叠（码点，默认 80）。同上，与 CHUNK_SIZE 一并冻结后不要随意改。
CCA_CHUNK_OVERLAP=80
# 检索向量空间标识（默认 corpus_v1）。切版/重建时改名，旧空间保留用于回退。
CCA_VECTOR_SPACE=corpus_v1

# ===================== 内部 API 与 MCP 连接（Phase 3） =====================
# 内部 API 基地址（只回环；生产按部署覆盖，不经公网代理暴露）。
CCA_INTERNAL_API_URL=http://127.0.0.1:8101
# MCP Streamable HTTP 端点 URL（服务身份 + 委派上下文由请求头传递）。
CCA_MCP_URL=http://127.0.0.1:8102/mcp
# MCP 监听/来源校验主机（只回环或私网）。
CCA_MCP_HOST=127.0.0.1
# MCP 监听端口（私有，不对外）。
CCA_MCP_PORT=8102
# MCP 路径（固定 /mcp；与 CCA_MCP_URL 保持一致）。
CCA_MCP_PATH=/mcp

# ===================== 助手执行预算 / SSE 写出（Phase 3） =====================
# 初始 AI 并发容量槽数（默认 5；仅接受时预置 5 行，运行期不改变，增减需显式运维）。
CCA_ASSISTANT_CAPACITY_SLOTS=5
# 单轮总截止（秒，默认 60）；到期转 EXECUTION_TIMEOUT 并核实写入。
CCA_ASSISTANT_DEADLINE_SECONDS=60
# 单轮模型决策次数上限（默认 6）。
CCA_ASSISTANT_MODEL_DECISIONS=6
# 单轮工具调用次数上限（默认 10）。
CCA_ASSISTANT_TOOL_CALLS=10
# runner 执行租约（秒，默认 30）。
CCA_ASSISTANT_LEASE_SECONDS=30
# 租约续期间隔（秒，默认 10）。
CCA_ASSISTANT_LEASE_RENEW_SECONDS=10
# SSE 心跳间隔（秒，默认 15；心跳为注释帧，不是业务事件）。
CCA_ASSISTANT_HEARTBEAT_SECONDS=15
# 事件队列块数（默认 64；慢连接在背压超时后关闭，runner 继续收尾）。
CCA_ASSISTANT_QUEUE_BLOCKS=64
# 客户端背压最大等待（秒，默认 2.0）。
CCA_ASSISTANT_BACKPRESSURE_SECONDS=2.0
# 单轮内存事件缓冲上限（条，默认 2048，最小 64）。
CCA_ASSISTANT_MAX_BUFFER_EVENTS=2048
# 单块正文最大码点（默认 4096）。
CCA_ASSISTANT_TOKEN_CHUNK_LIMIT=4096
# 单条工具结果/历史文本最大长度（码点，默认 20000）。
CCA_ASSISTANT_MAX_TEXT_LENGTH=20000

# ===================== 助手模型（TBD-04 骨架） =====================
# 默认 deterministic = 关键词规则 Provider：可复现、离线、**不是**生产 AI 能力。
# 切成 openai-compatible 后，后端会装配真实供应商适配位，但网络调用尚未实现 ——
# 每个请求都以 503 MODEL_UNAVAILABLE（「模型服务暂不可用」）显式失败，不会静默回退。
# 切真实供应商时必须同时给出 BASE_URL / API_KEY / NAME 三项，缺一项服务启动即失败。
CCA_MODEL_PROVIDER=deterministic
# 兼容 chat/completions 的服务地址（只支持 http/https）。示例：https://api.deepseek.com/v1
CCA_MODEL_BASE_URL=
# 供应商密钥。只放本机 .env 或部署环境变量，**不得**写进仓库、日志或截图。
CCA_MODEL_API_KEY=
# 模型名，原样透传给供应商（各厂商命名不同）。示例：deepseek-chat
CCA_MODEL_NAME=
# 采样温度（0–2，默认 0.3；越低越稳定）。
CCA_MODEL_TEMPERATURE=0.3
# 单次回复最大 token（1–32768，默认 2048）。
CCA_MODEL_MAX_TOKENS=2048
# 单次请求超时秒数（1–600，默认 30）。
CCA_MODEL_TIMEOUT_SECONDS=30
# 失败重试次数（0–3，默认 1；只对网络/5xx 有效，超时不重试）。
CCA_MODEL_MAX_RETRIES=1

# ===================== 助手检索兜底（演示/测试专用） =====================
# 真实检索（knowledge.search）不可用时，是否允许回落到**固定假证据**。
# 生产必须保持 false：假证据的文件名/页码会被当成权威引用对外展示（INV-04/05）。
# 置 true 只用于离线演示或评审环境，且必然在日志里留 warning。
CCA_ASSISTANT_ALLOW_STUB_EVIDENCE=false

# ===================== 真实 Embedding（检索向量） =====================
# 默认 deterministic：SHA-256 特征向量（64 维），可离线重复，只用于测试/演示。
# 切成 openai-compatible 后走真实语义向量（如 Qwen3-Embedding-0.6B，1024 维），
# 检索质量才算「真实」——切换后 parser_config_digest 变化，旧版本必须重建（重新入库发布）。
CCA_EMBEDDING_PROVIDER=deterministic
# OpenAI 兼容服务地址，只支持 http/https。示例：http://127.0.0.1:8892/v1（经 SSH 隧道的外部入口）
CCA_EMBEDDING_BASE_URL=
# 服务端不校验 model 时也必须填：它进摘要与日志，拼错不会有提示。
CCA_EMBEDDING_MODEL=Qwen3-Embedding-0.6B
# 服务不校验鉴权时可留空；非空才发 Authorization: Bearer。
CCA_EMBEDDING_API_KEY=
# 向量维度（默认 1024）。必须与服务端 /health 的 dim 一致，否则入库即失败（不写不同源向量）。
CCA_EMBEDDING_DIM=1024
# 单次 HTTP 请求最多几条（默认 16；服务端上限通常 256）。
CCA_EMBEDDING_BATCH_SIZE=16
# 单次请求超时秒数（默认 30）。
CCA_EMBEDDING_TIMEOUT_SECONDS=30
# 连接/超时/5xx 的有界重试次数（默认 2；4xx 不重试）。
CCA_EMBEDDING_MAX_RETRIES=2
# 批量内容级自检（默认 0=关；入库任务建议开 1）。
# 开启后每个 >=2 条的批次额外发 1 条单条请求，比对**批内最短那条**的余弦，>0.999 才接受。
# 理由：2026-10-28 服务端左填充池化取错下标那类缺陷，条数/维度/范数三项校验**全部正常**，
# 只有内容级比对能发现（2026-10-28 服务端左填充/池化错位缺陷）。
CCA_EMBEDDING_VERIFY_BATCH=0
# query 侧指令前缀（Qwen3 instruction-aware；doc 侧不加）。默认空串 = 行为不变。
# 实测中/英两种前缀都没有实质拉开相关/不相关间隔，默认保持关闭。
CCA_EMBEDDING_QUERY_PREFIX=

# ===================== 检索精排 Reranker（跨编码器） =====================
# 默认关闭（0）：不接入检索链路，行为与未引入时完全一致。
# 开启后由检索侧调用 POST {BASE_URL}{PATH}（契约见 app/adapters/rerank/remote.py）：
#   {"query", "documents", "top_n", "return_documents": false}
#   → {"results": [{"index", "relevance_score"}], ...}；分数 [0,1] 越高越相关。
CCA_RERANK_ENABLED=0
# 服务根地址（不含 path，只支持 http/https；LAN GPU 机直连或隧道入口）。
CCA_RERANK_BASE_URL=http://127.0.0.1:8892
# 端点路径；缺前导斜杠会自动补。
CCA_RERANK_PATH=/rerank
# 模型标识：只用于日志与 Reranker.name，**不**进请求体（契约无 model 字段）。
CCA_RERANK_MODEL=bge-reranker-v2-m3
# 单次请求超时（秒）与「连接错误/超时/408/5xx」重试次数（固定重试 1 次）。
CCA_RERANK_TIMEOUT_S=20
# 检索侧送入精排的候选上限（截断数，不是服务端 top_n）。
CCA_RERANK_TOP_K=8
# 精排分数门（2026-10-29 用评测主集 30 条标定；明细 verification/ai-eval/rerank-probe/）：
#   低于 LOW  → 直接判空，不花一次 LLM 判官（实测能拦下主题相近但无答案的片段）
#   高于等于 HIGH → 直接放行（单次判官否定不足以推翻接近满分的片段）
#   中间区间 → 才调 LLM 判官。HIGH < LOW 时自动抬到 LOW。
CCA_RERANK_LOW=0.30
CCA_RERANK_HIGH=0.90
# 精排不可用时是否放行（保留检索分数）；1=放行（默认，别把"有答案"变成"没找到"）、0=判空。
CCA_RERANK_FAIL_OPEN=1
# 单条文档送入前的最大字符数（超出截断，控制服务端 token 预算）。
CCA_RERANK_MAX_DOC_CHARS=1200
# 单次请求最多文档数；超出部分不送，分数按 0.0 与输入对齐。
CCA_RERANK_MAX_DOCS=32

# ===================== 检索依据判官（LLM 充分性门） =====================
# 两段式：top1 >= HIGH 直接放行、< LOW 直接判空、中间重叠带问 LLM「片段能否作为依据」。
# 判官与助手模型共用同一供应商（CCA_MODEL_*），可用 CCA_RETRIEVAL_JUDGE_MODEL 单独指定。
# 注意：这些键也读本文件（P1-5 起统一走 app.config.env_*：进程环境变量 > .env > 默认值），
# 因此**写进本文件即生效**，无需再启动前 export；进程环境变量仍然优先（显式空串也算显式值）。
# 默认 0（关）：不配模型时开启会白付延迟。**推荐启用配置是保守式**（2026-10-28 决策 A）：
#   判官只在 [0.45, 0.58) 生效，0.58 以上完全信任检索分数——判官在 0.58–0.65 段会误杀
#   关键词级可答题，而 uncovered 收益主要来自低分段。
# 实测（真实模型）：主集 based 18/20（达标）+ uncovered 8/10；留出集 based 10/10（达标）+ uncovered 6/10。
# 归因（判官在 0.58–0.65 段误杀关键词级可答题）与结构性上限：uncovered 最高分两条 0.645/0.643 高于 0.58 必被保留。
CCA_RETRIEVAL_JUDGE=0
CCA_RETRIEVAL_JUDGE_LOW=0.45
CCA_RETRIEVAL_JUDGE_HIGH=0.58
# 判官超时/无法解析时的动作：1=放行（默认，别把"有答案"变成"没找到"）、0=判空。
CCA_RETRIEVAL_JUDGE_FAIL_OPEN=1
CCA_RETRIEVAL_JUDGE_TIMEOUT_SECONDS=12
# 留空 = 用 CCA_MODEL_NAME。
CCA_RETRIEVAL_JUDGE_MODEL=
