# 环境变量清单（依据前端详细设计 §14.2）
# 红线：不得有任何令牌类变量（VITE_* 会被内联进产物）
# 禁止的模式：VITE_TOKEN / VITE_ACCESS_TOKEN / VITE_JWT / VITE_API_KEY / VITE_SECRET / VITE_ADMIN_PASSWORD

# API 基路径（生产由同源反代提供）
VITE_API_BASE=/api/v1

# 静态资源基路径
VITE_BASE=/

# 开发代理目标（仅 vite dev）。端口以 docs/phases/PHASE-PLAN.md §8.2 为准：公共 API = 8100
VITE_DEV_PROXY=http://127.0.0.1:8100

# 埋点上报地址；留空则不上报
VITE_TELEMETRY_ENDPOINT=

# 构建指纹
VITE_BUILD_SHA=

# mock 传输层开关（开发夹具，**显式 opt-in**）：
#   false（默认，真实后端，验收口径）→ 原生 fetch + server.proxy → 127.0.0.1:8100
#   true（仅调试 UI 时）→ 同源 mock 处理器，不产生任何网络请求
# 只有显式 'true' 才启用 mock；未设置/其他值一律走真实后端（防止误把 mock 带上线）。
VITE_USE_MOCK=false
