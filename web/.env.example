# 环境变量清单（依据前端详细设计 §14.2）
# 红线：不得有任何令牌类变量（VITE_* 会被内联进产物）
# 禁止的模式：VITE_TOKEN / VITE_ACCESS_TOKEN / VITE_JWT / VITE_API_KEY / VITE_SECRET / VITE_ADMIN_PASSWORD

# API 基路径（生产由同源反代提供）
VITE_API_BASE=/api/v1

# 静态资源基路径
VITE_BASE=/

# 开发代理目标（仅 vite dev）
VITE_DEV_PROXY=http://127.0.0.1:8080

# 埋点上报地址；留空则不上报
VITE_TELEMETRY_ENDPOINT=

# 构建指纹
VITE_BUILD_SHA=

# 阶段 B 骨架专用：mock 传输层开关（不接真实后端）
VITE_USE_MOCK=true
