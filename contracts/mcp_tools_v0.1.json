{
  "design_version": "0.1",
  "transport": "private Streamable HTTP",
  "description": "服务及委派凭据经传输上下文传入，不能进入模型arguments。业务失败用isError=true和统一错误信封。",
  "tools": [
    {
      "name": "get_my_schedule",
      "description": "读取当前身份本人课表，不允许指定目标用户。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "from_date": {
            "type": "string",
            "format": "date"
          },
          "to_date": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "empty"
            ]
          },
          "from_date": {
            "type": "string",
            "format": "date"
          },
          "to_date": {
            "type": "string",
            "format": "date"
          },
          "school_timezone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                "student_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                "course_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                "course_name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "class_date": {
                  "type": "string",
                  "format": "date"
                },
                "start_time": {
                  "type": "string",
                  "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
                },
                "end_time": {
                  "type": "string",
                  "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
                },
                "location": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 0,
                      "maxLength": 200
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "version": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "id",
                "student_id",
                "course_id",
                "course_name",
                "class_date",
                "start_time",
                "end_time",
                "location",
                "version"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "status",
          "from_date",
          "to_date",
          "school_timezone",
          "items"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "empty"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "items": {
                  "maxItems": 0
                }
              }
            },
            "else": {
              "properties": {
                "items": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    {
      "name": "search_course_docs",
      "description": "检索有效共享资料，空结果与依赖失败分开。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "empty"
            ]
          },
          "corpus_empty": {
            "type": "boolean"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "chunks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "chunk_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                "reference_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                "document_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                "version_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20000
                },
                "location_label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "page_number": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "chunk_id",
                "reference_id",
                "document_id",
                "version_id",
                "text",
                "location_label"
              ],
              "additionalProperties": false
            }
          },
          "references": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "reference_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                "document_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                "version_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                "file_name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                },
                "location_label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "page_number": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "reference_id",
                "document_id",
                "version_id",
                "file_name",
                "location_label"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "status",
          "corpus_empty",
          "revision",
          "chunks",
          "references"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "empty"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "chunks": {
                  "maxItems": 0
                }
              }
            },
            "else": {
              "properties": {
                "chunks": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    {
      "name": "save_study_plan",
      "description": "仅保存已有有效许可的指定草稿版本；许可与operation_id来自可信执行上下文。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "draft_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "draft_version": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "draft_id",
          "draft_version"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "created",
              "existing",
              "deleted"
            ]
          },
          "operation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96
          },
          "plan_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        "required": [
          "status",
          "operation_id",
          "plan_id"
        ],
        "additionalProperties": false
      }
    }
  ]
}
